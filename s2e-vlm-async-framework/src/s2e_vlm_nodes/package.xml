<?xml version="1.0"?>
<package format="3">
  <name>s2e_vlm_nodes</name>
  <version>0.1.0</version>
  <description>ROS 2 nodes and mock graph logic for the S2E VLM async framework.</description>
  <maintainer email="dev@example.com">S2E VLM Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rclpy</depend>
  <depend>s2e_vlm_core</depend>
  <depend>s2e_vlm_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_msgs</depend>
  <depend>tf2_ros</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>launch_testing</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
