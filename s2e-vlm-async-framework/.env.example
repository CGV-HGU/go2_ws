ROS_DOMAIN_ID=42
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
ROS_LOCALHOST_ONLY=0
GPU_DEVICE_ID=0
E2E_MODEL_PATH=/models/s2e/S2E
S2E_NAV_MODEL_ZOO_DIR=./nav_model_zoo
E2E_BACKEND=mock
VLM_BACKEND=mock
VLM_API_URL=http://qwen-vl-server:8000/v1/chat/completions
VLM_API_TIMEOUT_S=10.0
VLM_API_MAX_RETRIES=1
S2E_ARTIFACT_DIR=./artifacts
S2E_TEST_ARTIFACT_DIR=/artifacts/visualizer
S2E_SENSOR_CONFIG_DIR=
S2E_DEBUG_MODE=0
S2E_RUNTIME_ROLE=

# Mock runtime tuning. Docker Compose explicitly passes these into all mock runtime services.
S2E_MOCK_LIDAR_PERIOD_S=0.2
S2E_MOCK_CAMERA_WIDTH=640
S2E_MOCK_CAMERA_HEIGHT=480
S2E_MOCK_CAMERA_MODE=white
S2E_MOCK_CAMERA_PERIOD_S=0.1
S2E_MOCK_IMU_PERIOD_S=0.01
S2E_MOCK_ODOMETRY_PERIOD_S=0.02
S2E_MOCK_VLM_SCENARIOS=go
S2E_MOCK_VLM_PERIOD_S=2.0
S2E_MOCK_GROUND_Z_M=0.0
S2E_MOCK_MAX_GOAL_DISTANCE_M=8.0
S2E_MOCK_E2E_PERIOD_S=0.2
S2E_MOCK_VLM_TTL_S=8.0
S2E_MOCK_CONTROLLER_PERIOD_S=0.05
S2E_MOCK_TRAJECTORY_TTL_S=1.0
S2E_MOCK_SUPERVISOR_PERIOD_S=0.2
S2E_MOCK_HEARTBEAT_TIMEOUT_S=3.0
S2E_MOCK_ARTIFACT_DURATION_S=10.0
S2E_MOCK_ARTIFACT_SAVE_PERIOD_S=0.1
S2E_MOCK_DEBUG_VISUALIZER_PERIOD_S=0.2
